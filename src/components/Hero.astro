---
/* Hero / title section */
---

<header class="hero">
  <div class="container hero__inner">
    <!-- Logo placeholder -->
    <div class="hero__logo" aria-label="Logo placeholder">
      <span class="hero__logo-placeholder">LOGO</span>
    </div>

    <h1 class="hero__title">
      Brown Daily Herald<br />
      <span class="hero__highlight">2026 Housing Lottery Guide</span>
    </h1>

    <p class="hero__subtitle">
      Everything you need to navigate Brown's three-day housing selection period.
    </p>

    <!-- Decorative blueprint-style divider -->
    <svg class="hero__divider" viewBox="0 0 600 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <line x1="0" y1="10" x2="260" y2="10" stroke="var(--color-accent)" stroke-width=".7" stroke-dasharray="4 3" />
      <polygon points="295,3 305,10 295,17" fill="var(--color-accent-warm)" opacity=".7" />
      <line x1="340" y1="10" x2="600" y2="10" stroke="var(--color-accent)" stroke-width=".7" stroke-dasharray="4 3" />
    </svg>
  </div>
</header>

<style>
  .hero {
    padding: var(--space-2xl) 0 var(--space-xl);
    text-align: center;
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-accent) 6%, var(--color-bg)) 0%,
        var(--color-bg) 100%
      );
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    animation: heroIn 0.8s var(--ease-out) both;
  }

  @keyframes heroIn {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Logo placeholder */
  .hero__logo {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    border: 2px dashed var(--color-accent);
    display: grid;
    place-items: center;
    margin-bottom: var(--space-sm);
    opacity: .55;
  }
  .hero__logo-placeholder {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    color: var(--color-accent);
    text-transform: uppercase;
  }

  .hero__title {
    font-size: clamp(1.8rem, 4vw + 0.8rem, 3.2rem);
    color: var(--color-accent);
    letter-spacing: -0.02em;
  }

  .hero__highlight {
    color: var(--color-accent-warm);
    display: block;
    font-size: 0.6em;
    letter-spacing: 0.04em;
    margin-top: var(--space-xs);
  }

  .hero__subtitle {
    max-width: 36rem;
    color: var(--color-text-muted);
    font-size: 1.1rem;
  }

  .hero__divider {
    width: min(32rem, 90%);
    margin-top: var(--space-sm);
  }
</style>
