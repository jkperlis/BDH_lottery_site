---
import { House, CalendarDays } from '@lucide/astro';
import LotteryMap from './LotteryMap.astro';
import LiveMap from './LiveMap.astro';

/*
  Housing Data section
  - Year toggle (2025 / 2026)
  - 2025: ArcGIS map embed
  - 2026: placeholder or live data handled by LiveMap.astro
*/
---

<section class="housing reveal" id="housing-data">
  <div class="container">
    <!-- Section heading -->
    <div class="housing__header">
      <House size={28} strokeWidth={1.8} />
      <h2>Housing Data</h2>
    </div>

    <!-- Year toggle + external map controls -->
    <div class="housing__controls-row">
      <div class="housing__toggle-wrapper">
        <CalendarDays size={22} strokeWidth={1.8} />
        <div class="housing__toggle" role="radiogroup" aria-label="Select year">
          <button
            class="housing__toggle-btn active"
            role="radio"
            aria-checked="true"
            data-year="2025"
          >2025</button>
          <button
            class="housing__toggle-btn"
            role="radio"
            aria-checked="false"
            data-year="2026"
          >2026 (Live)</button>
        </div>
      </div>

      <!-- External controls for 2025 map -->
      <div class="housing__map-filters" id="housing-map-filters" aria-label="Housing map filters">
        <label class="housing__filter">
          <span>Gender</span>
          <select id="housing-filter-gender">
            <option value="ALL">All</option>
            <option value="COED">CoEd</option>
            <option value="COEDMALE">CoEd + Male</option>
            <option value="COEDFEMALE">CoEd + Female</option>
          </select>
        </label>

        <label class="housing__filter">
          <span>Group size</span>
          <select id="housing-filter-size">
            <option value="ALL">All sizes</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5</option>
          </select>
        </label>

        <label class="housing__filter">
          <span>Room type</span>
          <select id="housing-filter-type">
            <option value="ALL">All types</option>
            <option value="SUITE">Suite only</option>
          </select>
        </label>

        <label class="housing__filter">
          <span>Metric</span>
          <select id="housing-filter-metric">
            <option value="pct">Percent available</option>
            <option value="count">Rooms available (count)</option>
          </select>
        </label>
<!--
        <button id="housing-filter-refresh" class="housing__filter-refresh" type="button">
          Refresh times
        </button>
 -->
      </div>
    </div>

    <!-- Map panels -->
    <div class="housing__panels">
      <!-- 2025 panel (default visible before lottery) -->
      <div class="housing__panel active" id="panel-2025">
        <div class="housing__embed-placeholder">
          <LotteryMap />
          <p class="housing__note">
            Data from the 2025 housing selection period.
          </p>
        </div>
      </div>

      <!-- 2026 panel -->
      <div class="housing__panel" id="panel-2026">
        <div class="housing__embed-placeholder">
          <LiveMap />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.housing__toggle-btn');
  const panels  = document.querySelectorAll<HTMLDivElement>('.housing__panel');

  function switchToYear(year: string) {
    buttons.forEach((b) => {
      const isMatch = b.dataset.year === year;
      b.classList.toggle('active', isMatch);
      b.setAttribute('aria-checked', String(isMatch));
    });
    panels.forEach((p) => {
      p.classList.toggle('active', p.id === `panel-${year}`);
    });
  }

  /* Manual toggle */
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      switchToYear(btn.dataset.year!);
    });
  });

  /* Auto-switch to 2026 once countdown target has passed */
  const countdownEl = document.getElementById('countdown');
  if (countdownEl?.dataset.target) {
    const target = new Date(countdownEl.dataset.target).getTime();
    if (Date.now() >= target) {
      switchToYear('2026');
    }
  }
</script>

<style>
  .housing {
    padding: var(--space-md) 0 var(--space-sm);
  }

  .housing__header {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
    color: var(--color-accent);
  }
  .housing__header h2 {
    font-size: 1.8rem;
  }

  /* Toggle row */
  .housing__toggle-wrapper {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
    color: var(--color-accent);
  }

  .housing__toggle {
    display: inline-flex;
    background: var(--color-bg-dark);
    border-radius: var(--radius-md);
    padding: 3px;
    gap: 2px;
  }

  .housing__toggle-btn {
    font-family: var(--font-body);
    font-size: 0.9rem;
    padding: 0.45rem 1.1rem;
    border: none;
    border-radius: calc(var(--radius-md) - 2px);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all var(--duration) var(--ease-out);
  }
  .housing__toggle-btn.active {
    background: var(--color-surface);
    color: var(--color-accent);
    box-shadow: var(--shadow-card);
    font-weight: 600;
  }
  .housing__toggle-btn:hover:not(.active) {
    color: var(--color-text);
  }

  /* --- External map controls row --- */
  .housing__controls-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
    flex-wrap: wrap;
  }

  .housing__map-filters {
    display: flex;
    align-items: end;
    gap: 0.65rem;
    flex-wrap: wrap;
    padding: 0.55rem 0.7rem;
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .housing__map-filters.is-hidden {
    display: none;
  }

  .housing__filter {
    display: grid;
    gap: 0.22rem;
    min-width: 120px;
  }

  .housing__filter span {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    line-height: 1;
  }

  .housing__filter select {
    font-family: var(--font-body);
    font-size: 0.88rem;
    padding: 0.42rem 0.55rem;
    border-radius: 8px;
    border: 1px solid color-mix(in srgb, var(--color-text-muted) 30%, transparent);
    background: var(--color-bg);
    color: var(--color-text);
  }

  .housing__filter-refresh {
    font-family: var(--font-body);
    font-size: 0.85rem;
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    border: 1px solid color-mix(in srgb, var(--color-text-muted) 30%, transparent);
    background: var(--color-bg-dark);
    color: var(--color-text);
    cursor: pointer;
    transition: all var(--duration) var(--ease-out);
  }
  .housing__filter-refresh:hover {
    color: var(--color-accent);
  }

  .housing__filter-count {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    min-width: 2.5rem;
    align-self: center;
  }

  @media (max-width: 900px) {
    .housing__controls-row {
      align-items: stretch;
    }

    .housing__map-filters {
      width: 100%;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.65rem;
      align-items: end;
    }

    .housing__filter {
      min-width: 0;
    }

    .housing__filter select {
      width: 100%;
      min-width: 0;
    }
  }

  /* Panels — use visibility so iframe stays rendered */
  .housing__panels {
    position: relative;
  }
  .housing__panel {
    position: absolute;
    inset: 0;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s var(--ease-out);
  }
  .housing__panel.active {
    position: relative;
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
  }

  .housing__iframe {
    width: 100%;
    height: 560px;
    border: none;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    background: var(--color-surface);
    outline: none !important;
    border: 0 !important;
  }
  .housing__iframe:focus,
  .housing__iframe:focus-visible,
  .housing__iframe:focus-within {
    outline: none !important;
    border: 0 !important;
    box-shadow: var(--shadow-card);
  }

  .housing__note {
    margin-top: var(--space-sm);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-style: italic;
    text-align: center;
  }

  .housing__placeholder-box {
    background: var(--color-surface);
    border: 2px dashed var(--color-bg-dark);
    border-radius: var(--radius-md);
    height: 400px;
    display: grid;
    place-items: center;
    text-align: center;
    color: var(--color-text-muted);
  }
  .housing__placeholder-box p {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    color: var(--color-accent);
  }
  .housing__placeholder-box span {
    font-size: 0.85rem;
    opacity: 0.7;
    margin-top: var(--space-xs);
    display: block;
  }

  @media (max-width: 600px) {
    .housing__iframe {
      height: 70vh;
    }
  }
</style>